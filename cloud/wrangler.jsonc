{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kanso-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // Metrics stay on. Workers Logs keeps only what the Worker itself logs (route names and error
  // codes): invocation logs, which would record every request's URL and metadata, and traces are
  // pinned off, so no dashboard default can turn them on. `wrangler tail` still shows requests
  // live to whoever runs it (DEPLOYED.md).
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false }
  },
  // Purges, expired rate-limit rows and sessions, and R2 reconciliation (src/purge.ts).
  "triggers": { "crons": ["*/15 * * * *"] },
  // Write-free filters in front of D1: AUTH_LIMITER for /v2/auth/* and /v2/health, keyed by IP
  // group; SESSION_LIMITER for every session route, keyed by account ID (src/limits.ts).
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "SESSION_LIMITER", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kanso-sync",
      "database_id": "d9b0a705-d37b-46c0-b8f5-6ceabfd976b8",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "kanso-files"
    }
  ]
  // AUTH_PEPPER (required) is a secret: `wrangler secret put AUTH_PEPPER` (reads stdin; see README.md).
  // SYNC_TOKEN is no longer read; `admin purge-legacy` deletes it.
}
