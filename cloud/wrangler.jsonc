{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kanso-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // Metrics stay on; invocation logs (which would record every request) are off. The Worker
  // itself logs only route names and error codes.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  // Purges, expired rate-limit rows and sessions, and R2 reconciliation (src/purge.ts).
  "triggers": { "crons": ["*/15 * * * *"] },
  // The write-free front filter for /v2/auth/* and /v2/health, keyed by IP group.
  "ratelimits": [{ "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kanso-sync",
      "database_id": "d9b0a705-d37b-46c0-b8f5-6ceabfd976b8",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "kanso-files"
    }
  ]
  // AUTH_PEPPER (required) is a secret: `wrangler secret put AUTH_PEPPER` (reads stdin; see README.md).
  // SYNC_TOKEN is no longer read; `admin purge-legacy` deletes it.
}
