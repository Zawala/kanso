      "color": "#1F2937",
      "font_style": "italic"
    },
    "strong": {
      "color": "#1F2937",
      "font_weight": 700
    },
    "front_matter": "#8996A9",
    "html": "#2463EB",
    "escape": "#8996A9",
    "comment": {
      "color": "#8996A9",
      "font_style": "italic"
    },
    "comment_doc": {
      "color": "#8996A9",
      "font_style": "italic"
    },
    "keyword": "#7C3BED",
    "string": "#16A249",
    "string_special": "#16A249",
    "function": "#088EAF",
    "type": "#DB2979",
    "number": "#2463EB",
    "boolean": "#2463EB",
    "constant": "#2463EB",
    "variable": "#1F2937",
    "variable_special": "#1F2937",
    "property": "#1F2937",
    "attribute": "#088EAF",
    "tag": "#2463EB",
    "label": "#DB2979",
    "operator": "#7C3BED",
    "punctuation": "#2463EB",
    "bracket": "#2463EB"
  },
  "preview": {
    "text": "#212121",
    "heading": "#212121",
    "link": "#3874D6",
    "quote": "#666666",
    "border": "#D4D4D8",
    "code_background": "#FCFDFD",
    "code_text": "#212121",
    "inline_code_background": "#F2F2F2",
    "inline_code_text": "#1F1F1F",
    "table_header_background": "#E5E5E5"
