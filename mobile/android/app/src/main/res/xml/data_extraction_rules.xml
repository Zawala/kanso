<?xml version="1.0" encoding="utf-8"?>
<!--
  Kanso's notes stay on this phone: nothing of the app is in a backup, and
  nothing is copied to another phone.

  Android 12 and later read this file (android:dataExtractionRules), which
  android:allowBackup="false" alone does not cover: a device-to-device
  transfer would still copy the app's data. Every domain is excluded from
  both. A test (test/platform/backup_exclusion_test.dart) reads it.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
