[Desktop Entry]
Type=Application
Name=Kanso
GenericName=Notes
Comment=Markdown notes with sync and end-to-end encryption
Exec=kanso %u
Icon=kanso
Terminal=false
Categories=Office;Utility;TextEditor;
Keywords=notes;markdown;writing;
StartupWMClass=kanso
# Sign in with Apple returns to Kanso through kanso:// URLs.
MimeType=x-scheme-handler/kanso;
